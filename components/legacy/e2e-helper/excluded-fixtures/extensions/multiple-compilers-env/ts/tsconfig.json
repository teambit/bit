{
  "compilerOptions": {
    "lib": [
      "es2019", "DOM", "ES6" ,"DOM.Iterable", "ScriptHost"
    ],
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "strict": true,
    "moduleResolution": "node",
    // "node" is node10, which TS6 reports as the TS5107 deprecation error.
    "ignoreDeprecations": "6.0",
    "noImplicitAny": false,
    "rootDir": ".",
    "removeComments": true,
    "preserveConstEnums": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "dist"
  ]
}
