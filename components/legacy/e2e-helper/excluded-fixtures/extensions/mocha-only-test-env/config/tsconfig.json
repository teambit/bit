{
  "compilerOptions": {
    "lib": [
      "es2019", "DOM", "ES6" ,"DOM.Iterable"
    ],
    "target": "es2015",
    "module": "es2020",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    // "node" is node10, which TS6 reports as the TS5107 deprecation error.
    "ignoreDeprecations": "6.0",
    // TS6 no longer picks up node_modules/@types automatically, so the mocha globals
    // (describe/it/before) have to be requested by name.
    "types": ["mocha"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist"
  },
  "exclude": [
    "artifacts",
    "public",
    "dist",
    "node_modules",
    "package.json",
    "**/*.cjs"
  ],
  "include": [
    "**/*",
    "**/*.json"
  ]
}
