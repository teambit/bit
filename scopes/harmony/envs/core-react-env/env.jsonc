{
  /**
   * standardize your component dependencies.
   * @see https://bit.dev/docs/react-env/dependencies
   **/
  "policy": {
    /**
     * peer dependencies for components using that env.
     */
    "peers": [
      {
        "name": "react",
        /* the version to be installed and used by the env. pinned exact so react and
           react-dom always match — React 19's SSR requires identical versions */
        "version": "19.2.7",
        /* the range of versions this env's components are compatible with */
        "supportedRange": "^17.0.0 || ^18.0.0 || ^19.0.0"
      },
      {
        "name": "react-dom",
        "version": "19.2.7",
        "supportedRange": "^17.0.0 || ^18.0.0 || ^19.0.0"
      },
      {
        "name": "jest",
        "version": "29.3.1",
        "supportedRange": "29.3.1"
      },
      {
        "name": "graphql",
        "version": "15.8.0",
        "supportedRange": "^15.8.0"
      },
      {
        "name": "sass",
        "version": "1.72.0",
        "supportedRange": "^1.72.0"
      },
      {
        "name": "@mdx-js/react",
        "version": "3.1.1",
        "supportedRange": "^3.1.1"
      },
      {
        "name": "@teambit/mdx.ui.mdx-scope-context",
        "version": "1.1.1",
        "supportedRange": "^1.0.0"
      },
      {
        "name": "@types/react",
        "version": "^19.0.0",
        "supportedRange": "^19.0.0"
      },
      {
        "name": "@types/react-dom",
        "version": "^19.0.0",
        "supportedRange": "^19.0.0"
      },
      {
        "name": "oxlint",
        "version": "1.55.0",
        "supportedRange": "^1.0.0"
      },
      {
        "name": "oxlint-tsgolint",
        "version": "0.17.0",
        "supportedRange": "^0.17.0"
      },
      {
        "name": "@rspack/core",
        "version": "^2.0.0",
        "supportedRange": "^2.0.0"
      },
      {
        "name": "@rspack/dev-server",
        "version": "^2.0.0",
        "supportedRange": "^2.0.0"
      },
      {
        "name": "@rspack/plugin-react-refresh",
        "version": "^2.0.0",
        "supportedRange": "^2.0.0"
      },
      {
        "name": "sass-loader",
        "version": "^16.0.8",
        "supportedRange": "^16.0.8"
      },
      {
        "name": "@types/jest",
        "version": "^29.2.2",
        "supportedRange": "^29.2.2"
      },
      {
        "name": "@testing-library/jest-dom",
        "version": "6.5.0",
        "supportedRange": "^6.5.0"
      },
      {
        "name": "@testing-library/react",
        "version": "^16.0.0",
        "supportedRange": "^16.0.0"
      },
      {
        "name": "@testing-library/dom",
        "version": "^10.0.0",
        "supportedRange": "^10.0.0"
      },
      {
        "name": "@types/node",
        "version": "20.12.10",
        "supportedRange": "^20.12.10"
      }
    ],
    /**
     * dev dependencies for components using that env
     */
    "dev": []
  },

  /**
   * associate files with a specific dev service.
   * associated files are considered as dev files.
   * @see https://bit.dev/docs/react-env/dependencies#configure-files-as-dev-files
   **/
  "patterns": {
    /**
     * files to be loaded and displayed in the 'preview' tab.
     * @see https://bit.dev/docs/react-env/component-previews
     */
    "compositions": ["**/*.composition.*", "**/*.preview.*"],
    /**
     * files to be loaded and displayed in the 'overview' tab.
     * @see https://bit.dev/docs/react-env/component-docs
     */
    "docs": ["**/*.docs.*"],
    /* files to be included in the component testing */
    "tests": ["**/*.spec.*", "**/*.test.*"]
  }
}
