{
  /**
   * inherit the full policy (peers, dev deps) and dev-file patterns from the base
   * react-env, so they stay in sync with the installed react-env version instead
   * of drifting in a copied snapshot. this env only overrides the tsconfig
   * (see core-react-env.bit-env.ts).
   */
  "extends": "@teambit/react.react-env"
}
