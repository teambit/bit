/**
 * @see https://bit.dev/reference/typescript/typescript-config
 */
{
  "extends": "@teambit/react.react-env/dist/config/tsconfig.json",
  "compilerOptions": {
    // match the relaxations used by core-aspect-env and the node envs: capsule
    // builds type-check foreign components' sources (see core-react-env.bit-env.ts),
    // and those sources are only clean under these rules.
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    // CJS, not the base's es2020: bit's runtime require()s these components'
    // dists (e.g. compositions metadata in GeneratePreview), and the linked
    // package.json declares no "type": "module" — ESM output breaks that require.
    // Every other env in this repo (core-aspect-env, node envs) emits CJS too.
    "module": "CommonJS"
  },
  // re-declared (identical to the base): `include`/`exclude` inherited through
  // `extends` are resolved relative to the BASE file's directory, so leaving them
  // inherited makes capsule builds compile react-env's package config dir instead
  // of the component's files (emitting no dist, so jest then finds no tests).
  "exclude": ["artifacts", "public", "dist", "node_modules", "package.json", "**/*.cjs"],
  "include": ["**/*", "**/*.json"]
}
